{
  "name": "faihma-cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "build": "mkdir -p dist && cp -r index.html app.js config.js flashcards.js styles.css dist/",
    "perf:budget": "npm run build && bundlesize && lhci autorun --config=./lighthouserc.json"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "bundlesize": "^0.18.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^16.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^28.1.0",
    "lighthouse": "^12.6.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "bundlesize": [
    {
      "path": "./dist/app.js",
      "maxSize": "45 kB"
    },
    {
      "path": "./dist/styles.css",
      "maxSize": "30 kB"
    }
  ]
}
